{
  "expo": {
    "name": "Sensus",
    "slug": "sensus",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["web"],
    "userInterfaceStyle": "automatic",
    "scheme": "sensus",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sensus.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
